{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "website": {
      "root": "website/",
      "outputDirectory": ".",
      "cleanUrls": false,
      "trailingSlash": false,
      "rewrites": [
        { "source": "/:page(how-it-works|download|privacy|help|changelog)", "destination": "/:page.html" }
      ],
      "headers": [
        {
          "source": "/(.*)",
          "headers": [
            { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
          ]
        }
      ]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "website" } }
  ]
}
